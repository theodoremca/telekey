# Desktop public config. Secrets (TeleKey OpenAI, Stripe) live in functions/.env.
#
# Layering: `.env` then `.env.staging` or `.env.production`, chosen by
# TELEKEY_STAGE below (`staging` is the daily default).
#
# Copy:
#     cp .env.example .env
#     cp .env.staging.example .env.staging
#
# OPENAI_API_KEY here is optional BYOK (your key). Prefer the Keychain:
#     /Applications/TeleKey.app/Contents/MacOS/TeleKey set-api-key

TELEKEY_STAGE=staging
TELEKEY_FIREBASE_API_KEY=
