{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeleKey",
  "mainBinaryName": "TeleKey",
  "version": "0.2.3",
  "identifier": "com.theodoremca.telekey",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Theodore",
    "shortDescription": "Push-to-talk dictation",
    "longDescription": "Hold a shortcut anywhere on macOS, speak, and release. TeleKey transcribes what you said and puts polished text at your cursor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["telekey"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNEExNDlDNjEwOUIyNDkKUldSSnNnbGhuQlJLWVJwUU1zRTY4RUZBL1NnY3B6L1hPZUFIWW56bjhWdjU4T3kwQVhGRUJMdzMK",
      "endpoints": [
        "https://github.com/theodoremca/telekey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
