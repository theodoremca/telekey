rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nothing reads or writes Firestore from a client. The website uses
    // Firebase Authentication only and the app talks to the API; accounts,
    // usage, purchases and packs are all read and written by the Functions
    // API, the Instant relay and the scripts in functions/scripts, through
    // the Admin SDK, which does not go through these rules. So the rules say
    // no to everything: a signed-in user with the public Firebase key could
    // otherwise run reads on TeleKey's bill, and the packs were readable by
    // anyone at all.
    //
    // If a client ever does need to read something, open that one path here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
