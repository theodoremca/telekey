# Copy to functions/.env (gitignored). Fill in real values.
#
# `firebase deploy` reads this file from disk and sets the values on the
# Cloud Functions. The file itself is not uploaded (firebase.json ignore).
# To change a key: edit functions/.env and redeploy. Or edit the env vars
# on the Cloud Run service in Google Cloud Console.
#
# Do not put these in the desktop or web .env files.

OPENAI_API_KEY=

STRIPE_SECRET_KEY_STAGING=
STRIPE_WEBHOOK_SECRET_STAGING=
TELEKEY_SITE_URL_STAGING=https://telekey-staging.vercel.app

STRIPE_SECRET_KEY_PRODUCTION=
STRIPE_WEBHOOK_SECRET_PRODUCTION=
TELEKEY_SITE_URL_PRODUCTION=https://telekey.vercel.app

# After deploy, Stripe webhooks:
#   https://us-east1-telekey-app.cloudfunctions.net/staging/stripeWebhook
#   https://us-east1-telekey-app.cloudfunctions.net/api/stripeWebhook
