# TeleKey configuration
#
# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# Precedence: OPENAI_API_KEY in your shell > this file > the macOS Keychain.
# A .env file is PLAINTEXT on disk. For day-to-day use prefer the Keychain:
#     /Applications/TeleKey.app/Contents/MacOS/TeleKey set-api-key

OPENAI_API_KEY=sk-your-key-here
